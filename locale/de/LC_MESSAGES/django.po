msgid "activat"
msgstr "aktiviert"

msgid "desactivat"
msgstr "deaktiviert"

msgid "%d s'han saltat perquè no tenen dades de prova."
msgstr "%d wurden übersprungen, weil sie keine Testdaten haben."

