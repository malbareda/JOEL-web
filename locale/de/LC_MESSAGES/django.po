#: templates/gacha/gacharesult.html:1614
msgid "✨ SUPERLLEGENDARI ✨"
msgstr "✨ SUPERLEGENDÄR ✨"

#: templates/gacha/gacharesult.html:1614
msgid "✨ MEGA FANFARE ✨"
msgstr "✨ MEGA-FANFARE ✨"

#: templates/gacha/gacharesult.html:1623
msgid "Bé... un més per la col·lecció."
msgstr "Na ja... noch eins für die Sammlung."

#: templates/gacha/gacharesult.html:1624
msgid "Ah. Val."
msgstr "Ach so. Okay."

#: templates/gacha/gacharesult.html:1625
msgid "Suposo que compta."
msgstr "Zählt wohl auch."

#: templates/gacha/gacharesult.html:1626
msgid "Ni fu ni fa."
msgstr "Na ja, geht so."

#: templates/gacha/gacharesult.html:1627
msgid "Almenys no ha costat res."
msgstr "Immerhin hat es nichts gekostet."

#: templates/gacha/gacharesult.html:1628
msgid "Un clàssic sempre funciona."
msgstr "Ein Klassiker geht immer."

#: templates/gacha/gacharesult.html:1629
msgid "Sorpresa: cap sorpresa."
msgstr "Überraschung: keine Überraschung."

#: templates/gacha/gacharesult.html:1630
msgid "Ja en tenia un d'igual. I un altre. I un altre."
msgstr "Ich hatte schon eins genau wie dieses. Und noch eins. Und noch eins."

#: templates/gacha/gacharesult.html:1631
msgid "El destí ha parlat, i ha dit \"meh\"."
msgstr "Das Schicksal hat gesprochen, und es sagte \"na ja\"."

#: templates/gacha/gacharesult.html:1632
msgid "Segur que a algú li fa il·lusió."
msgstr "Bestimmt freut sich irgendjemand darüber."

#: templates/gacha/gacharesult.html:1633
msgid "Redoblament de tambors... per a això?"
msgstr "Ein Trommelwirbel... für sowas?"

#: templates/gacha/gacharesult.html:1634
msgid "Com deia la iaia: no tot poden ser diamants."
msgstr "Wie Oma immer sagte: Es kann nicht alles ein Diamant sein."

#: templates/gacha/gacharesult.html:1635
msgid "Tècnicament és una victòria."
msgstr "Technisch gesehen ist das ein Sieg."

#: templates/gacha/gacharesult.html:1636
msgid "La sort no hi era, avui."
msgstr "Das Glück war heute nicht dabei."

#: templates/gacha/gacharesult.html:1637
msgid "Un pas més cap a completar la col·lecció (algun dia)."
msgstr "Ein Schritt näher an der vollständigen Sammlung (irgendwann)."

#: templates/gacha/gacharesult.html:1640
msgid "Ei, no està gens malament!"
msgstr "Hey, das ist gar nicht schlecht!"

#: templates/gacha/gacharesult.html:1641
msgid "Mira mira, quina sorpresa més agradable!"
msgstr "Sieh mal an, was für eine angenehme Überraschung!"

#: templates/gacha/gacharesult.html:1642
msgid "Això sí que és un bon tirat!"
msgstr "Das ist mal ein guter Zug!"

#: templates/gacha/gacharesult.html:1643
msgid "M'agrada com sona, això."
msgstr "Das klingt schon mal gut."

#: templates/gacha/gacharesult.html:1644
msgid "Un pas per sobre de la mitjana, i ja és molt!"
msgstr "Einen Schritt über dem Durchschnitt, und das ist schon viel!"

#: templates/gacha/gacharesult.html:1645
msgid "Ara sí que comencem a parlar."
msgstr "Jetzt reden wir."

#: templates/gacha/gacharesult.html:1646
msgid "Prou bo per presumir-ne una mica."
msgstr "Gut genug, um ein bisschen damit anzugeben."

#: templates/gacha/gacharesult.html:1647
msgid "Rar de veritat, no rar de \"bé, suposo\"."
msgstr "Wirklich selten, nicht \"na ja, wohl eher\" selten."

#: templates/gacha/gacharesult.html:1648
msgid "Els déus del gacha t'han somrigut avui."
msgstr "Die Gacha-Götter haben dir heute zugelächelt."

#: templates/gacha/gacharesult.html:1649
msgid "Uau, mira com brilla!"
msgstr "Wow, schau wie das glänzt!"

#: templates/gacha/gacharesult.html:1650
msgid "Això val la pena ensenyar-ho als amics."
msgstr "Das hier zeigst du am besten deinen Freunden."

#: templates/gacha/gacharesult.html:1651
msgid "Bon començament, seguim pujant!"
msgstr "Guter Anfang, weiter geht’s nach oben!"

#: templates/gacha/gacharesult.html:1652
msgid "Ni el pitjor ni el millor, però queda genial."
msgstr "Weder das Beste noch das Schlechteste, aber es sieht super aus."

#: templates/gacha/gacharesult.html:1653
msgid "Ostres, quina gràcia que ha fet!"
msgstr "Boah, das war ein lustiger Treffer!"

#: templates/gacha/gacharesult.html:1654
msgid "Ep, ep, ep, mira qui s'ho ha guanyat!"
msgstr "Hey, hey, hey, schau mal, wer sich das verdient hat!"

#: templates/gacha/gacharesult.html:1657
msgid "IMPRESSIONANT!! Quina sort!"
msgstr "BEEINDRUCKEND!! Was für ein Glück!"

#: templates/gacha/gacharesult.html:1658
msgid "AIXÒ SÍ QUE ÉS ÈPIC!"
msgstr "DAS IST WIRKLICH EPISCH!"

#: templates/gacha/gacharesult.html:1659
msgid "NO M'HO PUC CREURE!!"
msgstr "ICH KANN ES NICHT GLAUBEN!!"

#: templates/gacha/gacharesult.html:1660
msgid "QUINA BOMBA ACABES DE TREURE!!"
msgstr "WAS FÜR EINEN KRACHER HAST DU GERADE GEZOGEN!!"

#: templates/gacha/gacharesult.html:1661
msgid "ÈPIC DE VERITAT, NO ÈPIC DE MENTIDA!"
msgstr "ECHT EPISCH, NICHT NUR SO GETAN!"

#: templates/gacha/gacharesult.html:1662
msgid "EL TEU EQUIP ET FELICITARÀ PER AIXÒ!"
msgstr "DEIN TEAM WIRD DIR DAFÜR GRATULIEREN!"

#: templates/gacha/gacharesult.html:1663
msgid "AIXÒ SÍ QUE MEREIX UNA CAPTURA DE PANTALLA!"
msgstr "DAS HIER VERDIENT EINEN SCREENSHOT!"

#: templates/gacha/gacharesult.html:1664
msgid "INCREÏBLE!! GUARDA'T AQUEST MOMENT!"
msgstr "UNGLAUBLICH!! HALTE DIESEN MOMENT FEST!"

#: templates/gacha/gacharesult.html:1665
msgid "HAS DESBLOQUEJAT EL NIVELL \"SORTUT\"!"
msgstr "DU HAST DAS LEVEL \"GLÜCKSPILZ\" FREIGESCHALTET!"

#: templates/gacha/gacharesult.html:1666
msgid "QUIN COP DE SORT MÉS BRUTAL!"
msgstr "WAS FÜR EIN KRASSER GLÜCKSTREFFER!"

#: templates/gacha/gacharesult.html:1667
msgid "ELS ALTRES ET TINDRAN ENVEJA, I RAÓ NO ELS FALTARÀ!"
msgstr "ALLE ANDEREN WERDEN NEIDISCH SEIN, UND ZU RECHT!"

#: templates/gacha/gacharesult.html:1668
msgid "AIXÒ ÉS DEL QUE ES PARLA A LA SALA DE PROFESSORAT!"
msgstr "DAVON WIRD MAN IM LEHRERZIMMER SPRECHEN!"

#: templates/gacha/gacharesult.html:1669
msgid "HAS GUANYAT LA LOTERIA DEL GACHA!"
msgstr "DU HAST DIE GACHA-LOTTERIE GEWONNEN!"

#: templates/gacha/gacharesult.html:1670
msgid "ÈPIC ÉS QUEDAR-SE CURT!"
msgstr "\"EPISCH\" IST NOCH UNTERTRIEBEN!"

#: templates/gacha/gacharesult.html:1671
msgid "AIXÒ HAURIA DE SORTIR ALS INFORMATIUS!"
msgstr "DAS GEHÖRT IN DIE NACHRICHTEN!"

#: templates/gacha/gacharesult.html:1674
msgid "★ LLEGENDARI ★ EL MILLOR DIA DE LA TEVA VIDA!!!"
msgstr "★ LEGENDÄR ★ DER BESTE TAG DEINES LEBENS!!!"

#: templates/gacha/gacharesult.html:1675
msgid "★★★ ATURA-HO TOT, HAS FET HISTÒRIA!!! ★★★"
msgstr "★★★ ALLES ANHALTEN, DU HAST GESCHICHTE GESCHRIEBEN!!! ★★★"

#: templates/gacha/gacharesult.html:1676
msgid "LES ESTRELLES S'HAN ALINEAT NOMÉS PER TU!!!"
msgstr "DIE STERNE HABEN SICH NUR FÜR DICH AUSGERICHTET!!!"

#: templates/gacha/gacharesult.html:1677
msgid "AIXÒ ÉS LLEGENDA, LITERALMENT!!!"
msgstr "DAS IST LEGENDE, IM WÖRTLICHEN SINNE!!!"

#: templates/gacha/gacharesult.html:1678
msgid "TRUCA A LA FAMÍLIA, TRUCA ALS AMICS, TRUCA A TOTHOM!!!"
msgstr "RUF DIE FAMILIE AN, RUF DIE FREUNDE AN, RUF EINFACH ALLE AN!!!"

#: templates/gacha/gacharesult.html:1679
msgid "EL GACHA HA PLORAT D'EMOCIÓ EN DONAR-TE AIXÒ!!!"
msgstr "DER GACHA HAT VOR RÜHRUNG GEWEINT, ALS ER DIR DAS GAB!!!"

#: templates/gacha/gacharesult.html:1680
msgid "AQUEST MOMENT ES RECORDARÀ PER GENERACIONS!!!"
msgstr "AN DIESEN MOMENT WIRD MAN SICH GENERATIONEN LANG ERINNERN!!!"

#: templates/gacha/gacharesult.html:1681
msgid "HAS ARRIBAT AL CIM DE L'OLIMP DEL GACHA!!!"
msgstr "DU HAST DEN GIPFEL DES GACHA-OLYMPS ERREICHT!!!"

#: templates/gacha/gacharesult.html:1682
msgid "NI EN ELS TEUS MILLORS SOMNIS T'HO ESPERAVES!!!"
msgstr "NICHT EINMAL IN DEINEN KÜHNSTEN TRÄUMEN HAST DU DAMIT GERECHNET!!!"

#: templates/gacha/gacharesult.html:1683
msgid "EL SERVIDOR SENCER HAURIA DE SABER-HO, AVUI!!!"
msgstr "DER GANZE SERVER SOLLTE DAS HEUTE ERFAHREN!!!"

#: templates/gacha/gacharesult.html:1684
msgid "QUE SONIN LES CAMPANES, HAS ACONSEGUIT EL LLEGENDARI!!!"
msgstr "LASST DIE GLOCKEN LÄUTEN, DU HAST DAS LEGENDÄRE ERHALTEN!!!"

#: templates/gacha/gacharesult.html:1685
msgid "AIXÒ NO ÉS SORT, ÉS DESTÍ!!!"
msgstr "DAS IST KEIN GLÜCK, DAS IST SCHICKSAL!!!"

#: templates/gacha/gacharesult.html:1686
msgid "GUARDA AQUESTA CAPTURA PER SEMPRE!!!"
msgstr "SPEICHERE DIESEN SCREENSHOT FÜR IMMER!!!"

#: templates/gacha/gacharesult.html:1687
msgid "EL MULTIVERS SENCER T'HA SOMRIGUT AVUI!!!"
msgstr "DAS GESAMTE MULTIVERSUM HAT DIR HEUTE ZUGELÄCHELT!!!"

#: templates/gacha/gacharesult.html:1688
msgid "ELS DÉUS DEL CODI T'HAN BENEÏT!!!"
msgstr "DIE GÖTTER DES CODES HABEN DICH GESEGNET!!!"

#: templates/gacha/gacharesult.html:1692
msgid "Hmm... això està trigant més del normal."
msgstr "Hmm... das dauert länger als sonst."

#: templates/gacha/gacharesult.html:1693
msgid "Espera..."
msgstr "Warte..."

#: templates/gacha/gacharesult.html:1694
msgid "Això no és un llegendari normal..."
msgstr "Das ist kein normales Legendär..."

#: templates/gacha/gacharesult.html:1695
msgid "No serà un...?"
msgstr "Ist das etwa ein...?"

#: templates/gacha/gacharesult.html:1696
msgid "AVISA ELS TEUS AMICS!"
msgstr "SAG DEINEN FREUNDEN BESCHEID!"

#: templates/gacha/gacharesult.html:1697
msgid "FES UNA CAPTURA DE PANTALLA!"
msgstr "MACH EINEN SCREENSHOT!"

#: templates/gacha/gacharesult.html:1698
msgid "EL SERVIDOR ESTÀ SUANT"
msgstr "DER SERVER SCHWITZT"

#: templates/gacha/gacharesult.html:1699
msgid "NO TANQUIS LA PESTANYA!!!"
msgstr "SCHLIESS DEN TAB NICHT!!!"

#: templates/gacha/gacharesult.html:1700
msgid "QUE ALGÚ AVISI EL PROFE!!!"
msgstr "HOLT JEMAND DEN LEHRER!!!"

#: templates/gacha/gacharesult.html:1701
msgid "OH NO. OH SÍ. OH NO. OH SÍ."
msgstr "OH NEIN. OH JA. OH NEIN. OH JA."

#: templates/gacha/gacharesult.html:1725
msgid "Has aconseguit"
msgstr "Du hast erhalten"

#: templates/gacha/gacharesult.html:1725
msgid "un Sticker!"
msgstr "einen Sticker!"

#: templates/gacha/gacharesult.html:1725
msgid "una Icona!"
msgstr "ein Icon!"

#: templates/gacha/gacharesult.html:1725
msgid "un Color!"
